# Frontend environment (copy to .env.local)
# Everything prefixed VITE_ is bundled into the browser, so NEVER put secrets here
# (no service_role key, no database password).

# Supabase: Project Settings → API
VITE_SUPABASE_URL=
# The anon / publishable key is designed to be public. Protect data with Row Level Security.
VITE_SUPABASE_ANON_KEY=

# WebExpoSyn API (server/), e.g. http://localhost:4000
VITE_API_URL=http://localhost:4000
