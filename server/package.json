{
  "name": "webexposyn-server",
  "private": true,
  "version": "0.1.0",
  "description": "WebExpoSyn API: scan orchestration, SSRF-safe target validation and the security engine (TLS, headers, DNS, email, exposure).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "tsx src/cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.2.18",
    "tldts": "^6.1.60",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^5.1.1"
  }
}
