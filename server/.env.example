# Port the API listens on
PORT=4000

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Secret used to derive domain ownership verification tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_SECRET=change-me-to-a-long-random-string

# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Fly, Nginx)
TRUST_PROXY=0

# Scan limits
MAX_CONCURRENT_SCANS=5
SCAN_RATE_LIMIT_PER_15_MIN=10
SCAN_TIMEOUT_MS=45000
