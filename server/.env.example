# development | production | test
# Defaults to production when unset, so a missing value fails safe.
NODE_ENV=development

# Port the API listens on
PORT=4000

# Comma-separated list of exact frontend origins allowed to call the API ("*" is refused)
CORS_ORIGINS=http://localhost:5173

# REQUIRED. Secret used to derive domain ownership verification tokens (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_SECRET=

# --- Authentication (Supabase) ---------------------------------------------
# "required" verifies the Supabase access token on every scan request.
# "disabled" is only accepted when NODE_ENV=development (local testing without Supabase).
AUTH_MODE=required
# Your project URL, e.g. https://abcd1234.supabase.co (Project Settings → API)
SUPABASE_URL=
# Only for older projects still using the legacy HS256 JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Lets the API save scan history (Project Settings → API Keys → Secret keys, sb_secret_...).
# SERVER ONLY. This key bypasses Row Level Security: never put it in the frontend,
# in chat, in screenshots or in git. Leave empty to run without saving history.
SUPABASE_SECRET_KEY=

# Set to the number of reverse proxies in front of the API (Render/Railway/Fly = 1).
# Wrong values let attackers spoof IPs to dodge rate limits.
TRUST_PROXY=0

# --- Scan limits ------------------------------------------------------------
MAX_CONCURRENT_SCANS=5
SCAN_RATE_LIMIT_PER_15_MIN=10
TARGET_SCANS_PER_10_MIN=3
SCAN_TIMEOUT_MS=60000

# --- Billing (Paystack) -----------------------------------------------------
# Free plan: number of different websites a user can scan (rescans are always free).
FREE_SITE_LIMIT=3
# Paystack secret key (Settings → API Keys & Webhooks). Use sk_test_... while testing.
# SERVER ONLY: never put it in the frontend, in chat, in screenshots or in git.
PAYSTACK_SECRET_KEY=
# Plan code of your NGN 5,000 monthly plan (Products → Plans), e.g. PLN_xxxxxxxx
PAYSTACK_PLAN_CODE=
# Pro price in kobo (500000 = NGN 5,000). Must match the Paystack plan amount.
PRO_PRICE_KOBO=500000
# Public URL of the frontend. Paystack sends users back to APP_URL/billing after paying.
APP_URL=http://localhost:5173
